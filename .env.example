# Copie para .env e preencha. O .env está no .gitignore e nunca deve ser commitado.
# Provedor do modelo: gemini (API do Google) ou local (LM Studio, roda no seu PC, sem custo)
LLM_PROVIDER=local
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=qwen/qwen3-4b
LOCAL_TIMEOUT=180

# Opcional com LLM_PROVIDER=local: se preenchida, o Gemini vira reserva
GOOGLE_API_KEY=sua-chave-do-google-ai-studio

# Opcionais
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1
SCORE_LIMITE=70
RECURSION_LIMIT=15
LEADS_PATH=data/leads.xlsx
FRONTEND_ORIGINS=http://localhost:5173
